# Copy to .env and fill in. Required keys have no "# optional" comment.
VT_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
WHOIS_API_KEY=
CENSYS_API_KEY=

URLSCAN_API_KEY=                  # optional
HYBRID_API_KEY=                   # optional
URLHAUS_API_KEY=                  # optional; also used for ThreatFox

API_KEY=                           # for api intigration with other tools (optional)

JWT_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# AI Analyst Summary (web UI only) — talks to a local Ollama instance.
# Leave unset to use the default: http://localhost:11434/api/generate
# OLLAMA_URL=http://your-ollama-host:11434/api/generate
# OLLAMA_MODEL=qwen2.5:3b-instruct
